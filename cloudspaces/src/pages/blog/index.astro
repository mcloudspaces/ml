---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year
const byYear: Record<string, typeof posts> = {};
for (const p of posts) {
  const y = p.data.date.getFullYear().toString();
  if (!byYear[y]) byYear[y] = [];
  byYear[y].push(p);
}
const years = Object.keys(byYear).sort((a, b) => +b - +a);

function readTime(body: string) {
  const words = body?.split(/\s+/).length ?? 0;
  return Math.max(1, Math.ceil(words / 200));
}
---

<Layout title="Blog — cloudspaces.gr" description="Writing about data platforms, infrastructure, and ML engineering.">

  <section class="blog-hero">
    <div class="container">
      <p class="section-label">Blog</p>
      <h1 class="blog-title">Writing</h1>
      <p class="blog-sub">Notes on data platforms, infrastructure, Kubernetes, and the ML engineer's journey. Honest, technical, occasional.</p>
    </div>
  </section>

  <div class="glow-divider"></div>

  <section class="blog-body">
    <div class="container">
      {posts.length === 0 ? (
        <div class="empty">
          <p>First post coming soon.</p>
          <p style="margin-top:8px">Subscribe via <a href="/rss.xml">RSS</a> to be notified.</p>
        </div>
      ) : (
        years.map(year => (
          <div class="year-group">
            <h2 class="year-label">{year}</h2>
            <div class="post-list">
              {byYear[year].map(p => (
                <a href={`/blog/${p.slug}`} class="post-row">
                  <div class="post-meta">
                    <span class="post-date">
                      {p.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                    </span>
                    <span class="post-read">{readTime(p.body)} min</span>
                  </div>
                  <div class="post-content">
                    <h3 class="post-title">{p.data.title}</h3>
                    <p class="post-desc">{p.data.description}</p>
                    <div class="post-tags">
                      {p.data.tags.slice(0,4).map((t: string) => <span class="tag">{t}</span>)}
                    </div>
                  </div>
                  <span class="post-arrow">→</span>
                </a>
              ))}
            </div>
          </div>
        ))
      )}
    </div>
  </section>

</Layout>

<style>
.blog-hero { padding: 80px 0 48px; }
.blog-title { font-size: clamp(32px, 5vw, 52px); font-weight: 800; letter-spacing: -0.03em; color: var(--text); margin-bottom: 10px; }
.blog-sub { font-size: 16px; color: var(--text2); max-width: 500px; line-height: 1.7; }

.blog-body { padding: 48px 0 80px; }

.year-group { margin-bottom: 48px; }
.year-label {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.15em;
  color: var(--text3);
  text-transform: uppercase;
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}

.post-list { display: flex; flex-direction: column; }
.post-row {
  display: grid;
  grid-template-columns: 90px 1fr 28px;
  gap: 20px;
  align-items: center;
  padding: 20px 0;
  border-bottom: 1px solid var(--border);
  transition: background 0.2s;
}
.post-row:hover .post-title { color: var(--accent); }
.post-row:hover .post-arrow { opacity: 1; transform: translateX(4px); color: var(--accent); }

.post-meta { display: flex; flex-direction: column; gap: 4px; }
.post-date { font-family: var(--mono); font-size: 11px; color: var(--text3); }
.post-read { font-family: var(--mono); font-size: 10px; color: var(--text3); }

.post-title { font-size: 16px; font-weight: 600; color: var(--text); letter-spacing: -0.01em; margin-bottom: 5px; transition: color 0.2s; }
.post-desc { font-size: 13px; color: var(--text2); margin-bottom: 8px; }
.post-tags { display: flex; flex-wrap: wrap; gap: 5px; }

.post-arrow { font-family: var(--mono); font-size: 14px; color: var(--text3); opacity: 0; transition: all 0.2s; }

.empty { padding: 60px 0; text-align: center; font-family: var(--mono); font-size: 13px; color: var(--text3); }
.empty a { color: var(--accent); }

@media (max-width: 580px) {
  .post-row { grid-template-columns: 1fr; gap: 8px; }
  .post-meta { flex-direction: row; gap: 12px; }
  .post-arrow { display: none; }
}
</style>
