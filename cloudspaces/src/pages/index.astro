---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .filter(p => p.data.status === 'active')
  .slice(0, 3);
---

<Layout>

  <!-- ── HERO ─────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <div class="hero-eyebrow animate-fade-up" style="animation-delay:0ms">
        <span class="tag">Available for opportunities</span>
        <span class="hero-location">📍 Greece</span>
      </div>

      <h1 class="hero-title animate-fade-up" style="animation-delay:80ms">
        Data &amp; ML<br/>
        <span class="hero-title-accent">Platform</span><br/>
        Engineer
      </h1>

      <p class="hero-sub animate-fade-up" style="animation-delay:180ms">
        10+ years operating Linux and networks. Now building and running 
        large-scale data platforms on the Apache ecosystem, Kubernetes, 
        and cloud infrastructure — with a growing focus on ML platform engineering.
      </p>

      <div class="hero-cta animate-fade-up" style="animation-delay:280ms">
        <a href="/about" class="btn btn--primary">About me</a>
        <a href="/projects" class="btn btn--ghost">See projects →</a>
      </div>

      <div class="hero-tags animate-fade-up" style="animation-delay:380ms">
        {['Linux', 'Kubernetes', 'Apache Kafka', 'Hadoop', 'Dremio', 'Cloudera', 'AWS', 'MLflow', 'dbt', 'Iceberg'].map(t => (
          <span class="tag">{t}</span>
        ))}
      </div>
    </div>

    <!-- decorative terminal -->
    <div class="hero-terminal animate-fade-up" style="animation-delay:460ms">
      <div class="container">
        <div class="terminal">
          <div class="terminal-bar">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="terminal-title">~  bash</span>
          </div>
          <div class="terminal-body">
            <p><span class="t-prompt">cloudspaces</span><span class="t-sym">:~$</span> <span class="t-cmd">whoami</span></p>
            <p class="t-out">platform-engineer · data · ml · infra</p>
            <p class="t-blank">&nbsp;</p>
            <p><span class="t-prompt">cloudspaces</span><span class="t-sym">:~$</span> <span class="t-cmd">kubectl get nodes</span></p>
            <p class="t-out">NAME         STATUS   ROLES           AGE   VERSION</p>
            <p class="t-out">data-node-1  Ready    data-platform   847d  v1.28.0</p>
            <p class="t-out">ml-node-1    Ready    ml-platform     412d  v1.28.0</p>
            <p class="t-blank">&nbsp;</p>
            <p><span class="t-prompt">cloudspaces</span><span class="t-sym">:~$</span> <span class="t-cmd">uptime</span></p>
            <p class="t-out">10+ years in production <span class="cursor">▋</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="glow-divider"></div>

  <!-- ── STATS ─────────────────────────────────────── -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        {[
          { num: '10+', label: 'Years Linux & Networking' },
          { num: '5+',  label: 'Years Cloud & Kubernetes' },
          { num: '3+',  label: 'Data Platform Stacks' },
          { num: '∞',   label: 'Coffee-Driven Deployments' },
        ].map(({ num, label }) => (
          <div class="stat">
            <span class="stat-num">{num}</span>
            <span class="stat-label">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="glow-divider"></div>

  <!-- ── PROJECTS ───────────────────────────────────── -->
  {projects.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="section-label">Active projects</p>
        <div class="card-grid">
          {projects.map(p => (
            <a href={`/projects`} class="card">
              <div class="card-top">
                <span class="tag tag--orange">{p.data.status}</span>
              </div>
              <h3 class="card-title">{p.data.title}</h3>
              <p class="card-desc">{p.data.description}</p>
              <div class="card-tags">
                {p.data.tags.slice(0,4).map((t:string) => <span class="tag tag--blue">{t}</span>)}
              </div>
            </a>
          ))}
        </div>
        <div class="section-more">
          <a href="/projects" class="btn btn--ghost">All projects →</a>
        </div>
      </div>
    </section>
  )}

  <div class="glow-divider"></div>

  <!-- ── BLOG ──────────────────────────────────────── -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="section-label">Latest writing</p>
        <div class="post-list">
          {posts.map(p => (
            <a href={`/blog/${p.slug}`} class="post-row">
              <span class="post-date">{p.data.date.toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' })}</span>
              <span class="post-title">{p.data.title}</span>
              <span class="post-arrow">→</span>
            </a>
          ))}
        </div>
        <div class="section-more">
          <a href="/blog" class="btn btn--ghost">All posts →</a>
        </div>
      </div>
    </section>
  )}

  <div class="glow-divider"></div>

  <!-- ── CTA ───────────────────────────────────────── -->
  <section class="section cta-section">
    <div class="container cta-inner">
      <div>
        <h2 class="cta-title">Let's build something solid.</h2>
        <p class="cta-sub">Whether it's a data platform, an ML pipeline, or just a conversation about infrastructure — I'm always up for it.</p>
      </div>
      <a href="/contact" class="btn btn--primary">Get in touch</a>
    </div>
  </section>

</Layout>

<style>
/* HERO */
.hero { padding: 100px 0 60px; }
.hero-eyebrow { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
.hero-location { font-family: var(--mono); font-size: 12px; color: var(--text3); }
.hero-title {
  font-size: clamp(52px, 9vw, 96px);
  font-weight: 800;
  line-height: 1.0;
  letter-spacing: -0.04em;
  color: var(--text);
  margin-bottom: 28px;
}
.hero-title-accent { color: var(--accent); }
.hero-sub { font-size: 17px; color: var(--text2); max-width: 520px; line-height: 1.75; margin-bottom: 36px; font-weight: 300; }
.hero-cta { display: flex; gap: 12px; margin-bottom: 44px; flex-wrap: wrap; }
.hero-tags { display: flex; flex-wrap: wrap; gap: 7px; }

/* TERMINAL */
.hero-terminal { margin-top: 60px; }
.terminal {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  max-width: 560px;
  box-shadow: 0 24px 80px rgba(0,0,0,0.4);
}
.terminal-bar {
  background: var(--bg3);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 7px;
  border-bottom: 1px solid var(--border);
}
.dot { width: 11px; height: 11px; border-radius: 50%; }
.dot.red    { background: #FF5F57; }
.dot.yellow { background: #FEBC2E; }
.dot.green  { background: #28C840; }
.terminal-title { font-family: var(--mono); font-size: 11px; color: var(--text3); margin-left: 8px; }
.terminal-body { padding: 20px 24px; font-family: var(--mono); font-size: 13px; line-height: 1.9; }
.t-prompt { color: var(--accent); }
.t-sym    { color: var(--text3); }
.t-cmd    { color: var(--text); }
.t-out    { color: var(--text2); padding-left: 0; }
.t-blank  { height: 6px; }
.cursor   { animation: blink 1s step-end infinite; color: var(--accent); }

/* STATS */
.stats-section { padding: 56px 0; }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
.stat { background: var(--bg2); padding: 32px 24px; text-align: center; }
.stat-num { display: block; font-size: 36px; font-weight: 800; color: var(--accent); letter-spacing: -0.03em; font-family: var(--sans); }
.stat-label { display: block; font-family: var(--mono); font-size: 11px; color: var(--text3); margin-top: 6px; letter-spacing: 0.05em; }

/* SECTION */
.section { padding: 72px 0; }
.section-more { margin-top: 32px; }

/* CARDS */
.card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
.card {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: border-color 0.2s, transform 0.2s;
  cursor: pointer;
}
.card:hover { border-color: var(--border2); transform: translateY(-3px); }
.card-top { display: flex; justify-content: flex-end; }
.card-title { font-size: 16px; font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
.card-desc { font-size: 13.5px; color: var(--text2); line-height: 1.65; flex: 1; }
.card-tags { display: flex; flex-wrap: wrap; gap: 5px; }

/* POST LIST */
.post-list { display: flex; flex-direction: column; }
.post-row {
  display: grid;
  grid-template-columns: 110px 1fr 20px;
  align-items: center;
  gap: 16px;
  padding: 18px 0;
  border-bottom: 1px solid var(--border);
  transition: color 0.2s;
}
.post-row:first-child { border-top: 1px solid var(--border); }
.post-row:hover .post-title { color: var(--accent); }
.post-row:hover .post-arrow { opacity: 1; transform: translateX(4px); }
.post-date { font-family: var(--mono); font-size: 11px; color: var(--text3); }
.post-title { font-size: 15px; color: var(--text); font-weight: 500; }
.post-arrow { color: var(--accent); opacity: 0; transition: all 0.2s; font-family: var(--mono); }

/* CTA */
.cta-section { padding: 80px 0; }
.cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; background: var(--bg2); border: 1px solid var(--border); border-radius: 14px; padding: 48px; }
.cta-title { font-size: 28px; font-weight: 700; color: var(--text); letter-spacing: -0.02em; margin-bottom: 8px; }
.cta-sub { font-size: 15px; color: var(--text2); max-width: 440px; line-height: 1.7; }

@media (max-width: 640px) {
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .post-row { grid-template-columns: 1fr; gap: 4px; }
  .post-arrow { display: none; }
  .cta-inner { flex-direction: column; align-items: flex-start; }
}
</style>
